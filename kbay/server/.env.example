# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://kbay_app:change-me-app-password@localhost:5432/kbay_dev
DATABASE_ADMIN_URL=postgres://kbay:kbay@localhost:5432/kbay_dev
APP_DB_PASSWORD=change-me-app-password
PUBLIC_URL=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
