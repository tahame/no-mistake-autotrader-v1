# K-BAY production settings. deploy.sh creates .env with random secrets on first run.
# Never commit the real .env.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Public address people open (https). Use <ip-with-dashes>.sslip.io until the domain is ready.
PUBLIC_URL=https://kbay.example.sslip.io
APP_PORT=8090
# Web push (phone notifications). deploy.sh generates these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
BACKUP_KEEP_DAYS=30
BACKUP_AT_UTC_HOUR=22
